<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText
        android:id="@+id/refinePrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/refine_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="4" />

    <RadioGroup
        android:id="@+id/conditionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/condEdge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/cond_edge" />

        <RadioButton
            android:id="@+id/condDepth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cond_depth" />

        <RadioButton
            android:id="@+id/condFace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cond_face" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/refine_note"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
